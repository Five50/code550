:root {
  --background: 255 255 255;
  --foreground: 15 23 42;
  /* slate-900 */
  --card: 255 255 255;
  --card-foreground: 15 23 42;
  /* slate-900 */
  --popover: 255 255 255;
  --popover-foreground: 15 23 42;
  /* slate-900 */
  --primary: 59 130 246;
  /* blue-500 */
  --primary-foreground: 255 255 255;
  --secondary: 241 245 249;
  /* slate-100 */
  --secondary-foreground: 51 65 85;
  /* slate-700 */
  --muted: 241 245 249;
  /* slate-100 */
  --muted-foreground: 100 116 139;
  /* slate-500 */
  --accent: 219 234 254;
  /* blue-100 */
  --accent-foreground: 29 78 216;
  /* blue-700 */
  --destructive: 239 68 68;
  /* red-500 */
  --destructive-foreground: 255 255 255;
  --border: 226 232 240;
  /* slate-200 */
  --input: 226 232 240;
  /* slate-200 */
  --ring: 59 130 246;
  /* blue-500 */
  --radius: 0.5rem;
}

.dark {
  --background: 2 6 23;
  /* slate-950 */
  --foreground: 248 250 252;
  /* slate-50 */
  --card: 2 6 23;
  /* slate-950 */
  --card-foreground: 248 250 252;
  /* slate-50 */
  --popover: 2 6 23;
  /* slate-950 */
  --popover-foreground: 248 250 252;
  /* slate-50 */
  --primary: 96 165 250;
  /* blue-400 */
  --primary-foreground: 30 64 175;
  /* blue-800 */
  --secondary: 30 41 59;
  /* slate-800 */
  --secondary-foreground: 248 250 252;
  /* slate-50 */
  --muted: 30 41 59;
  /* slate-800 */
  --muted-foreground: 148 163 184;
  /* slate-400 */
  --accent: 30 41 59;
  /* slate-800 */
  --accent-foreground: 96 165 250;
  /* blue-400 */
  --destructive: 220 38 38;
  /* red-600 */
  --destructive-foreground: 248 250 252;
  /* slate-50 */
  --border: 30 41 59;
  /* slate-800 */
  --input: 30 41 59;
  /* slate-800 */
  --ring: 147 197 253;
  /* blue-300 */
}

* {
  --tw-border-opacity: 1;
  border-color: rgb(226 232 240 / var(--tw-border-opacity, 1));
}

body {
  --tw-bg-opacity: 1;
  background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1));
  --tw-text-opacity: 1;
  color: rgb(15 23 42 / var(--tw-text-opacity, 1));
  font-family: 'Fira Sans', ui-sans-serif, system-ui, sans-serif;
}

/* Typography */

h1, h2, h3, h4, h5, h6 {
  font-family: 'Saira', 'Fira Sans', ui-sans-serif, system-ui, sans-serif;
  font-weight: 600;
}

h1 {
  font-weight: 700;
  font-size: 2.5rem;
  line-height: 1.2;
}

