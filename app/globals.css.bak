  font-weight: 100 900;

  font-stretch: 75% 125%;

  font-style: italic;

  font-display: swap;
}

/* Fira Sans Font Family */

@font-face {
  font-family: 'Fira Sans';

  src: url('/fonts/fira-sans/FiraSans-Regular.woff2') format('woff2');

  font-weight: 400;

  font-style: normal;

