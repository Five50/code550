  font-weight: 700;

  font-style: italic;

  font-display: swap;
}

/* View Transitions */

@supports (view-transition-name: none) {
  /* Enable view transitions for the entire document */

  :root {
    view-transition-name: root;
  }

  /* Default fade transition for all elements */

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.3s;
    animation-timing-function: ease-in-out;
  }

  /* Slide transition for main content */

  ::view-transition-old(main),
  ::view-transition-new(main) {
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Smooth header transition */

  ::view-transition-old(header),
  ::view-transition-new(header) {
    animation-duration: 0.2s;
    animation-timing-function: ease-out;
  }

  /* Custom slide-in animation for new content */

  @keyframes slide-in-from-right {
    from {
      opacity: 0;
      transform: translateX(100px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slide-out-to-left {
    from {
      opacity: 1;
      transform: translateX(0);
    }

    to {
      opacity: 0;
      transform: translateX(-100px);
    }
  }

  /* Apply slide animations to main content */

  ::view-transition-new(main) {
    animation-name: slide-in-from-right;
  }

  ::view-transition-old(main) {
    animation-name: slide-out-to-left;
  }

  /* Fade animation for smaller elements */

  @keyframes fade-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes fade-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  /* Special transition for post/page content */

  .view-transition-content {
    view-transition-name: content;
  }

  ::view-transition-old(content),
  ::view-transition-new(content) {
    animation-duration: 0.35s;
    animation-timing-function: ease-in-out;
  }

  ::view-transition-new(content) {
    animation-name: fade-in;
  }

  ::view-transition-old(content) {
    animation-name: fade-out;
  }
}

