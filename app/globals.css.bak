/* Hide scrollbar for IE, Edge and Firefox */

/* WordPress Block Library Styles - Core WordPress Blocks */

/* Layout & Alignment */

.alignfull {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
}

.alignwide {
  width: 100%;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
}

.aligncenter {
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

/* Text Alignment */

.has-text-align-center {
  text-align: center;
}

.has-text-align-left {
  text-align: left;
}

.has-text-align-right {
  text-align: right;
}

/* Font Sizes */

.has-small-font-size {
  font-size: 0.875rem;
}

.has-normal-font-size {
  font-size: 1rem;
}

.has-medium-font-size {
  font-size: 1.125rem;
}

.has-large-font-size {
  font-size: 1.25rem;
}

.has-x-large-font-size {
  font-size: 1.5rem;
}

/* Cover Block */

.wp-block-cover {
  position: relative;
  min-height: 430px;
  padding: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

.wp-block-cover__background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.wp-block-cover__inner-container {
  position: relative;
  z-index: 2;
  width: 100%;
  color: white;
}

.wp-block-cover.alignfull {
  margin-top: 0;
  margin-bottom: 0;
}

/* Background Dim */

.has-background-dim::before,
.wp-block-cover__background.has-background-dim {
  background-color: rgba(0, 0, 0, 0.5);
}

.has-background-dim-0::before,
.wp-block-cover__background.has-background-dim-0 {
  background-color: rgba(0, 0, 0, 0);
}

.has-background-dim-10::before,
.wp-block-cover__background.has-background-dim-10 {
  background-color: rgba(0, 0, 0, 0.1);
}

.has-background-dim-20::before,
.wp-block-cover__background.has-background-dim-20 {
  background-color: rgba(0, 0, 0, 0.2);
}

.has-background-dim-30::before,
.wp-block-cover__background.has-background-dim-30 {
  background-color: rgba(0, 0, 0, 0.3);
}

.has-background-dim-40::before,
.wp-block-cover__background.has-background-dim-40 {
  background-color: rgba(0, 0, 0, 0.4);
}

.has-background-dim-50::before,
.wp-block-cover__background.has-background-dim-50 {
  background-color: rgba(0, 0, 0, 0.5);
}

.has-background-dim-60::before,
.wp-block-cover__background.has-background-dim-60 {
  background-color: rgba(0, 0, 0, 0.6);
}

.has-background-dim-70::before,
.wp-block-cover__background.has-background-dim-70 {
  background-color: rgba(0, 0, 0, 0.7);
}

.has-background-dim-80::before,
.wp-block-cover__background.has-background-dim-80 {
  background-color: rgba(0, 0, 0, 0.8);
}

.has-background-dim-90::before,
.wp-block-cover__background.has-background-dim-90 {
  background-color: rgba(0, 0, 0, 0.9);
}

.has-background-dim-100::before,
.wp-block-cover__background.has-background-dim-100 {
  background-color: rgba(0, 0, 0, 1);
}

/* Global Padding */

.has-global-padding {
  padding-left: var(--wp--style--root--padding-left, 1rem);
  padding-right: var(--wp--style--root--padding-right, 1rem);
}

/* Layout Constrained */

.is-layout-constrained {
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
}

/* WordPress Color Classes - Common theme colors */

.has-contrast-background-color {
  background-color: #000000;
}

.has-contrast-color {
  color: #000000;
}

.has-primary-background-color {
  background-color: #007cba;
}

.has-primary-color {
  color: #007cba;
}

.has-secondary-background-color {
  background-color: #006ba1;
}

.has-secondary-color {
  color: #006ba1;
}

.has-white-background-color {
  background-color: #ffffff;
}

.has-white-color {
  color: #ffffff;
}

.has-black-background-color {
  background-color: #000000;
}

.has-black-color {
  color: #000000;
}

/* Block Spacing */

.wp-block-group,
.wp-block-cover,
.wp-block-columns {
  margin-bottom: 1.5rem;
}

/* Columns */

.wp-block-columns {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}

.wp-block-column {
  flex: 1;
  min-width: 250px;
}

/* Buttons */

.wp-block-button {
  margin-bottom: 1rem;
}

.wp-block-button__link {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background-color: #007cba;
  color: white;
  text-decoration: none;
  border-radius: 0.25rem;
  transition: background-color 0.2s;
}

.wp-block-button__link:hover {
  background-color: #005a87;
}

/* Lists */

.wp-block-list {
  padding-left: 1.5rem;
}

/* Quote */

.wp-block-quote {
  border-left: 4px solid #007cba;
  padding-left: 1rem;
  margin: 1.5rem 0;
  font-style: italic;
}

/* Separator */

.wp-block-separator {
  border: none;
  border-top: 1px solid #cccccc;
  margin: 2rem 0;
}

/* Spacer */

.wp-block-spacer {
  clear: both;
}

/* Prose Typography Component */

.prose {
  font-family: 'Fira Sans', ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Prose Headings */

.prose h1 {
  font-size: 2.25rem;
  line-height: 2.5rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 2rem;
  margin-bottom: 1rem;
}

.prose h2 {
  font-size: 1.875rem;
  line-height: 2.25rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 2rem;
  margin-bottom: 1rem;
}

.prose h3 {
  font-size: 1.5rem;
  line-height: 2rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
}

.prose h4 {
  font-size: 1.25rem;
  line-height: 1.75rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
}

.prose h5 {
  font-size: 1.125rem;
  line-height: 1.75rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 1rem;
  margin-bottom: 0.5rem;
}

.prose h6 {
  font-size: 1rem;
  line-height: 1.5rem;
  font-weight: 500;
  letter-spacing: -0.025em;
  margin-top: 1rem;
  margin-bottom: 0.5rem;
}

/* Prose Text Elements */

.prose p {
  font-size: 1rem;
  line-height: 1.75rem;
  margin-bottom: 1rem;
}

.prose strong {
  font-weight: 600;
}

.prose em {
  font-style: italic;
}

.prose del {
  text-decoration-line: line-through;
}

.prose small {
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 500;
  line-height: 1;
}

.prose sub,
.prose sup {
  font-size: 0.75rem;
  line-height: 1rem;
}

/* Prose Links */

.prose a {
  text-decoration-line: underline;
  text-underline-offset: 4px;
  text-decoration-color: rgb(59 130 246 / 0.5);
  transition-property: color, text-decoration-color;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.prose a:hover {
  text-decoration-color: rgb(59 130 246);
  color: rgb(59 130 246);
}

/* Prose Lists */

.prose ul {
  padding-left: 0;
  list-style-type: none;
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}

.prose ul > li {
  position: relative;
  padding-left: 1.5rem;
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}

.prose ul > li::before {
  content: '';
  position: absolute;
  left: 0.25rem;
  top: 0.6875em;
  height: 0.375rem;
  width: 0.375rem;
  border-radius: 9999px;
  background-color: rgb(15 23 42 / 0.8);
}

.prose ol {
  list-style-type: decimal;
  padding-left: 1.5rem;
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}

.prose ol > li {
  padding-left: 0.5rem;
  margin-top: 0.5rem;
  margin-bottom: 0.5rem;
}

/* Prose Code */

.prose code {
  position: relative;
  border-radius: 0.25rem;
  background-color: rgb(241 245 249 / 0.5);
  padding-left: 0.3rem;
  padding-right: 0.3rem;
  padding-top: 0.2rem;
  padding-bottom: 0.2rem;
  font-family: 'Fira Mono', ui-monospace, SFMono-Regular, 'SF Mono', monospace;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 500;
}

.prose pre {
  overflow-x: auto;
  border-radius: 0.5rem;
  border-width: 1px;
  background-color: rgb(241 245 249 / 0.5);
  padding: 1rem;
  margin-top: 1rem;
  margin-bottom: 1rem;
}

.prose pre code {
  background-color: transparent;
  padding: 0;
  font-size: 0.875rem;
  line-height: 1.25rem;
  display: block;
  width: 100%;
}

/* AltoFuel Brand Fonts */

@font-face {
  font-family: 'Saira';

  src: url('/fonts/saira/Saira-VariableFont_wdth,wght.woff2') format('woff2-variations');

  font-weight: 100 900;

  font-stretch: 75% 125%;

  font-style: normal;

  font-display: swap;
}

