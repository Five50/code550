WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"

# WordPress Authentication (for accessing settings and protected content)
# Create an Application Password in WordPress Admin: Users > Your Profile > Application Passwords
WORDPRESS_AUTH_USER="your-username"
WORDPRESS_AUTH_PASSWORD="your-application-password"

# If using the revalidate plugin
# You can generate by running `openssl rand -base64 32` in the terminal
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"
