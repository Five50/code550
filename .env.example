# ===========================================
# WordPress Connection
# ===========================================

# Full URL to your WordPress site (e.g., https://wordpress.example.com)
WORDPRESS_URL="https://wordpress.example.com"

# Hostname only, used for Next.js image optimization (e.g., wordpress.example.com)
WORDPRESS_HOSTNAME="wordpress.example.com"

# ===========================================
# WordPress Authentication
# ===========================================
# Create an Application Password in WordPress Admin:
# Users > Your Profile > Application Passwords
WORDPRESS_AUTH_USER="your-username"
WORDPRESS_AUTH_PASSWORD="your-application-password"

# ===========================================
# WordPress-Side Security (Manual Setup Required)
# ===========================================
# To fully hide the WordPress origin, configure your WordPress site to
# require authentication for ALL REST API requests. Options:
#   1. "Disable REST API" plugin — blocks unauthenticated access
#   2. Custom mu-plugin that returns 401 for requests without valid auth
#   3. Server-level Basic Auth on /wp-json/* (Apache/Nginx config)
# The Next.js app sends auth headers on every request when the credentials
# above are set, so it will continue to work after lockdown.

# ===========================================
# Revalidation Webhook
# ===========================================
# Used to validate incoming webhooks from WordPress for cache revalidation.
# Generate with: openssl rand -base64 32
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"
